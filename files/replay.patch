+// The agent verbs: `rer business FAMILY VERB` is one row here. A row names the Business MCP tool it calls, the argument a bare
+// word fills (positional), the arguments the call needs (required) and whether --wait follows it to its end (wait). A new
+// tool needs one row; `rer business call TOOL --flag value` reaches a tool that has none yet.
+export const rows = {
+ 'installations list': { tool: 'installations.list', about: 'The apps installed for this company, with their state and address' },
+ 'installation status': { tool: 'installation.status', positional: 'installation_id', required: ['installation_id'], about: 'One installed app: state, version, hosting, progress' },
+ 'change request': { tool: 'change.request', positional: 'intent', required: ['installation_id', 'intent'], wait: 'change', about: 'Ask for a change to an app, in plain words' },
+ 'change follow': { tool: 'change.follow', positional: 'change_id', required: ['change_id'], wait: 'change', about: 'Where a requested change is, and what happens next' },
+ 'change publish': { tool: 'change.publish', positional: 'change_id', required: ['change_id'], about: 'Publish a change whose preview is ready' },
+ 'update list': { tool: 'update.list', positional: 'installation_id', required: ['installation_id'], about: 'Updates available for an app' },
+ 'update prepare': { tool: 'update.prepare', positional: 'installation_id', required: ['installation_id'], about: 'Prepare the app for its next update' },
+ 'update build': { tool: 'update.build', positional: 'installation_id', required: ['installation_id', 'preparation_id'], about: 'Build a prepared update' },
+ 'update follow': { tool: 'update.follow', positional: 'installation_id', required: ['installation_id'], wait: 'update', about: 'Where an update is' },
+ 'domain set': { tool: 'domain.set', positional: 'domain', required: ['domain'], about: "Set the company's domain" },
+ 'domain prove': { tool: 'domain.prove', required: ['method'], about: 'Prove the domain: --method txt|cloudflare' },
+ 'domain attach': { tool: 'domain.attach', positional: 'hostname', required: ['installation_id', 'surface', 'hostname'], about: 'Give an app surface a hostname (--public-path optional)' },
+ 'domain records': { tool: 'domain.records', positional: 'installation_id', required: ['installation_id'], about: 'The DNS records an app needs' },
+ 'domain check': { tool: 'domain.check', required: ['installation_id', 'domain_id'], about: 'Check that a domain is attached and answering' },
+ 'domain remove': { tool: 'domain.remove', required: ['installation_id', 'domain_id'], about: 'Detach a domain from an app' },
+ 'import start': { tool: 'import.start', positional: 'installation_id', required: ['installation_id'], about: "Start moving an old tool's data into an app" },
+ 'import follow': { tool: 'import.follow', positional: 'installation_id', required: ['installation_id'], about: 'Where an import is' },
+ 'profile set': { tool: 'business.profile.set', required: ['profile'], about: 'Save the business profile: --profile JSON or --profile @FILE' },
+ 'plan draft': { tool: 'plan.draft', about: 'Draft the plan: --FIELD VALUE, or --args JSON' },
+ 'plan read': { tool: 'plan.read', about: 'Read the plan' },
+ 'plan request-approval': { tool: 'plan.request_approval', about: 'Ask the owner to approve the plan' },
+ 'app owner-signed-in': { tool: 'app.owner_signed_in', positional: 'installation_id', required: ['installation_id'], about: 'Has the owner signed in to the app yet' },
+ 'app send-sign-in-link': { tool: 'app.send_sign_in_link', positional: 'installation_id', required: ['installation_id'], about: 'Email the owner a sign-in link to the app' },
+};
+// Short flag names for argument names, so `--app ID` is `--installation-id ID`.
+export const aliases = { app: 'installation_id' };
+export const families = [...new Set(Object.keys(rows).map(name => name.split(' ')[0]))];
+export const agentFamilies = new Set([...families, 'tools', 'mcp', 'call']);
diff --git a/cli/business/agent-verbs.mjs b/cli/business/agent-verbs.mjs
new file mode 100644
index 00000000..4d1cd2f0
--- /dev/null
+++ b/cli/business/agent-verbs.mjs
@@ -0,0 +1,132 @@
+import { Api } from './api.mjs';
+import { mcpClient, ownerLink } from './questions.mjs';
+import { paired } from './local-commands.mjs';
+import { describe } from './errors.mjs';
+import { businessCommand } from './invocation.mjs';
+import { rows } from './agent-table.mjs';
+import { parseArguments, place, missing, Usage } from './agent-args.mjs';
+import { plain, refusalText, clean } from './agent-output.mjs';
+import { waitFor, failedState, stateName, exitStillWaiting } from './agent-wait.mjs';
+import { agentUsage } from './agent-help.mjs';
+
+export const exitNotBuilt = 3;
+
+class Refused extends Error {
+ constructor(data) { super(data?.message ?? 'Business refused the action.'); this.data = data; }
+}
+
+// A tool's structuredContent, or the refusal it came back with.
+async function invoke(session, tool, args) {
+ const result = await session.call(tool, args);
+ if (result?.isError) throw new Refused(result.structuredContent ?? { status: 'refused', message: result.content?.find?.(part => part?.type === 'text')?.text });
+ if (!result?.structuredContent || typeof result.structuredContent !== 'object') throw Error(`Business returned no result for ${tool}.`);
+ return result.structuredContent;
+}
+
+const idOf = (data, key) => data[key]?.id ?? data[`${key}_id`];
+
+async function change(row, args, control, session, say) {
+ let data = await invoke(session, row.tool, args);
+ const id = idOf(data, 'change') ?? args.change_id;
+ if (typeof id === 'string') say(`Change ${clean(id, 80)}: ${clean(stateName(data) ?? 'requested', 60)}`);
+ if (!control.wait && !control.publish) {
+  if (row.tool === 'change.request' && typeof id === 'string') say(`Follow it with: ${businessCommand(`change follow ${id} --wait`)}`);
+  return data;
+ }
+ if (typeof id !== 'string') throw Error('Business did not name the change, so there is nothing to follow.');
+ const options = { say: state => say(`Change ${id}: ${state}`), timeout: control.timeout, interval: control.interval, from: stateName(data) };
+ const follow = () => invoke(session, 'change.follow', { change_id: id });
+ let waited = await waitFor(follow, options);
+ if (waited.ended && control.publish && !failedState(waited.data) && waited.data.next === 'publish') {
+  const published = await invoke(session, 'change.publish', { change_id: id });
+  say(`Change ${id}: ${stateName(published) ?? 'publishing'}`);
+  waited = await waitFor(follow, { ...options, publishing: true, from: stateName(published) ?? 'publishing' });
+ }
+ data = waited.data;
+ if (!waited.ended) throw Object.assign(Error(`Still working after ${control.timeout ?? 1800} seconds. Keep waiting with: ${businessCommand(`change follow ${id} --wait`)}`), { exitCode: exitStillWaiting, data });
+ if (failedState(data)) throw Object.assign(Error(`The change ${stateName(data)}: ${clean(data.change?.message ?? data.message ?? 'no reason given', 300)}`), { exitCode: 1, data });
+ if (data.next === 'ask_owner') say('The owner needs to answer something in Business before this can go on.');
+ else if (data.next === 'publish') say(`Its preview is ready. Publish it with: ${businessCommand(`change publish ${id}`)}`);
+ return data;
+}
+
+async function update(row, args, control, session, say) {
+ const data = await invoke(session, row.tool, args);
+ if (!control.wait) return data;
+ const waited = await waitFor(() => invoke(session, 'update.follow', args), { say: state => say(`Update ${args.installation_id}: ${state}`), timeout: control.timeout, interval: control.interval });
+ if (!waited.ended) throw Object.assign(Error(`Still working after ${control.timeout ?? 1800} seconds. Keep waiting with: ${businessCommand(`update follow ${args.installation_id} --wait`)}`), { exitCode: exitStillWaiting, data: waited.data });
+ if (failedState(waited.data)) throw Object.assign(Error(`The update ${stateName(waited.data)}.`), { exitCode: 1, data: waited.data });
+ return waited.data;
+}
+const waiters = { change, update };
+
+async function work(row, parsed, session, out) {
+ const args = place(row, parsed), absent = missing(row, args), { control } = parsed;
+ if (absent.length) throw new Usage(`${row.tool} needs ${absent.map(name => `--${name.replaceAll('_', '-')}`).join(', ')}. Run rer business ${row.name.split(' ')[0]} --help.`);
+ for (const flag of ['wait', 'publish']) {
+  if (control[flag] && !(row.wait && (flag === 'wait' || row.tool.startsWith('change.')))) throw new Usage(`${row.name} does not take --${flag}.`);
+ }
+ const say = line => out.line(line);
+ out.result(row.tool, row.wait ? await waiters[row.wait](row, args, control, session, say) : await invoke(session, row.tool, args));
+}
+
+// Lines for a person go to stdout; with --json only the final structuredContent does, and progress goes to stderr.
+function output(json) {
+ return {
+  line: text => (json ? process.stderr : process.stdout).write(text + '\n'),
+  result: (tool, data) => { if (json) process.stdout.write(JSON.stringify(data) + '\n'); else for (const line of plain(tool, data)) process.stdout.write(line + '\n'); },
+ };
+}
+
+async function listTools(session, json) {
+ const tools = [];
+ let cursor;
+ for (let page = 0; page < 20; page++) {
+  const response = await session.exchange('tools/list', cursor ? { cursor } : {});
+  if (response.error) throw Error('Business MCP refused tools/list.');
+  tools.push(...(Array.isArray(response.result?.tools) ? response.result.tools : []));
+  cursor = response.result?.nextCursor;
+  if (!cursor) break;
+ }
+ if (json) process.stdout.write(JSON.stringify({ tools }) + '\n');
+ else for (const tool of tools) process.stdout.write(`${clean(tool.name, 80)}  ${clean(String(tool.description ?? '').split('\n')[0], 160)}`.trimEnd() + '\n');
+}
+
+function usage(text) { process.stderr.write(`${text}\n${agentUsage}`); return 2; }
+
+export async function agentCommand(argv) {
+ const [first, second, ...rest] = argv;
+ if (first === 'mcp') return (await import('./mcp-bridge.mjs')).bridge();
+ let row, tail = rest;
+ if (first === 'tools') { row = { name: 'tools' }; tail = [second, ...rest].filter(item => item !== undefined); }
+ else if (first === 'call') {
+  if (!/^[a-z][a-z0-9_.]{0,80}$/.test(second ?? '')) return usage('Name the tool: rer business call TOOL [--flag VALUE].');
+  row = { name: `call ${second}`, tool: second };
+ } else {
+  row = rows[`${first} ${second}`] && { name: `${first} ${second}`, ...rows[`${first} ${second}`] };
+  if (!row) return usage(`Unknown command: rer business ${first}${second ? ` ${clean(second, 40)}` : ''}.`);
+ }
+ let parsed;
+ try { parsed = await parseArguments(tail); } catch (error) { if (error instanceof Usage) return usage(error.message); throw error; }
+ const out = output(parsed.control.json);
+ let state;
+ try {
+  const connection = await paired();
+  state = connection.state;
+  const session = await mcpClient(new Api(state.origin, connection.credential));
+  if (row.name === 'tools') await listTools(session, parsed.control.json);
+  else await work(row, parsed, session, out);
+  return 0;
+ } catch (error) {
+  if (error instanceof Usage) return usage(error.message);
+  if (error instanceof Refused) {
+   const text = refusalText(error.data, ownerLink(state));
+   if (parsed.control.json) process.stdout.write(JSON.stringify(error.data ?? {}) + '\n');
+   process.stderr.write(text + '\n');
+   return error.data?.status === 'not_built' ? exitNotBuilt : 1;
+  }
+  if (error.data && parsed.control.json) process.stdout.write(JSON.stringify(error.data) + '\n');
+  process.stderr.write(describe(error) + '\n');
+  return error.exitCode ?? 1;
+ }
+}
diff --git a/cli/business/agent-wait.mjs b/cli/business/agent-wait.mjs
new file mode 100644
index 00000000..5af1ef10
--- /dev/null
+++ b/cli/business/agent-wait.mjs
@@ -0,0 +1,28 @@
+import { pause } from './api.mjs';
+import { clean } from './agent-output.mjs';
+
+export const exitStillWaiting = 75;
+// What a follow result says. A change or an update is `{change|update: {state, ...}, next}`; next tells the agent what to do.
+const stateOf = data => data.change?.state ?? data.update?.state ?? data.import?.state ?? data.state;
+const finished = new Set(['live', 'failed', 'refused', 'done']);
+const stops = new Set(['publish', 'done', 'ask_owner']);
+
+/** Poll `follow()` every interval until the work ends or the timeout passes, saying each state change through `say`.
+ * `publishing` waits through next=publish (a publish just made is not done yet): only live, done, ask_owner, failed or
+ * refused end it. Returns { data, ended }; ended is false when the timeout ran out first. */
+export async function waitFor(follow, { say, timeout = 1800, interval = 15, publishing = false, from }) {
+ const deadline = Date.now() + timeout * 1000;
+ let last = from, data;
+ for (;;) {
+  data = await follow();
+  const state = stateOf(data), next = data.next;
+  if (state !== last) say(`${clean(state ?? 'unknown', 60)}${typeof data.change?.title === 'string' ? ` (${clean(data.change.title, 100)})` : ''}`);
+  last = state;
+  const over = finished.has(state) || next === 'ask_owner' || next === 'done' || !publishing && stops.has(next) || state === undefined && next === undefined;
+  if (over) return { data, ended: true };
+  if (Date.now() + interval * 1000 > deadline) return { data, ended: false };
+  await pause(interval * 1000);
+ }
+}
+export const failedState = data => ['failed', 'refused'].includes(stateOf(data));
+export const stateName = stateOf;
