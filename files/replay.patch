+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createServer} from 'node:http';
+import {spawn} from 'node:child_process';
+import {once} from 'node:events';
+import {mkdtemp,mkdir,writeFile,rm} from 'node:fs/promises';
+import {join,resolve} from 'node:path';
+import {credentialHandle} from './business/state.mjs';
+
+const base=resolve(import.meta.dirname,'..'),entry=join(base,'bin/rer.mjs');
+const device='bz_device_synthetic-command-computer',secret='synthetic-scoped-command-secret',account='a'.repeat(32);
+async function fixture(t) {
+ const home=await mkdtemp(join(base,'.business-connect-command-'));t.after(()=>rm(home,{recursive:true,force:true}));
+ const state={issued:0,revocations:0,refuse:false,cleanupFails:false,expiryMs:900000,leases:new Map()};
+ const server=createServer(async(req,res)=>{
+  let text='';for await(const data of req)text+=data;
+  const body=text?JSON.parse(text):{},root='/api/business/executors/cloudflare-token';
+  const json=(status,value)=>{res.writeHead(status,{'content-type':'application/json'});res.end(JSON.stringify(value));};
+  if(req.headers.authorization!=='Bearer '+device)return json(401,{error:'pairing refused'});
+  if(req.url===root&&req.method==='POST'){
+   state.issued++;if(state.refuse)return json(403,{error:secret});
+   const lease={lease_id:body.lease_id,grant_id:body.grant_id,business_id:'business',executor_id:'computer',account_id:account,credential_expires_at:new Date(Date.now()+state.expiryMs).toISOString(),cleanup_status:'active',provider_credential_revoked:false};
+   state.leases.set(lease.lease_id,lease);return json(200,{...lease,credential:secret});
+  }
+  const id=req.url.slice(root.length+1).split('/')[0],lease=state.leases.get(id);
+  if(!lease)return json(404,{error:'no such command'});
+  if(req.url.endsWith('/revoke')){state.revocations++;return json(200,{...lease,cleanup_status:state.cleanupFails?'unconfirmed':'revoked',provider_credential_revoked:!state.cleanupFails});}
+  return json(200,lease);
+ });
+ await new Promise(resolve=>server.listen(0,'127.0.0.1',resolve));
+ t.after(()=>new Promise(resolve=>{server.close(resolve);server.closeAllConnections();}));
+ const origin=`http://127.0.0.1:${server.address().port}`;
+ await mkdir(join(home,'.rer/business'),{recursive:true});
+ await writeFile(join(home,'.rer/business/state.json'),JSON.stringify({origin,businessId:'business',executorId:'computer',credentialVersion:2}));
+ await writeFile(join(home,'fake-keychain.json'),JSON.stringify({[credentialHandle(origin,'business')]:device}));
+ const env={PATH:process.env.PATH,HOME:home,RER_NO_UPDATE_CHECK:'1',CI:'true',NODE_OPTIONS:`--import=${new URL('./fixtures/business/register.mjs',import.meta.url).pathname}`,
+  CLOUDFLARE_API_TOKEN:'ambient-broad-token',CLOUDFLARE_ACCOUNT_ID:'f'.repeat(32),CF_API_TOKEN:'ambient-alias-token'};
+ const start=args=>{
+  const child=spawn(process.execPath,[entry,'business',...args],{cwd:home,env,stdio:['pipe','pipe','pipe']});let stdout='',stderr='';
+  child.stdout.on('data',data=>stdout+=data);child.stderr.on('data',data=>stderr+=data);child.stdin.end();
+  const result=once(child,'close').then(([code,signal])=>({code,signal,stdout,stderr}));
+  return {child,result,output:()=>stdout+stderr};
+ };
+ const run=async command=>(await start(['run','--grant','grant-1','--',...command]).result);
+ return {home,state,start,run};
+}
+
+test('business run preserves arguments and exits, injects only the scoped child environment, masks split output and cleans success, failure and spawn errors',async t=>{
+ const f=await fixture(t);
+ const script=`const token=process.env.CLOUDFLARE_API_TOKEN; if(token!==${JSON.stringify(secret)}||process.env.CLOUDFLARE_ACCOUNT_ID!==${JSON.stringify(account)}||process.env.CF_API_TOKEN)process.exit(92); console.log(JSON.stringify(process.argv.slice(1))); process.stdout.write(token.slice(0,8)); setTimeout(()=>{process.stdout.write(token.slice(8));process.stderr.write(token.slice(0,11));setTimeout(()=>{process.stderr.write(token.slice(11));console.log(' finished');process.exit(Number(process.argv[1]));},10)},10);`;
+ for(const code of [0,17]){
+  const result=await f.run([process.execPath,'-e',script,String(code),'argument with spaces','--help','$(literal)','']);
+  assert.equal(result.code,code,result.stderr);assert.equal(result.signal,null);
+  assert.ok(result.stdout.includes(JSON.stringify([String(code),'argument with spaces','--help','$(literal)',''])));
+  assert.match(result.stdout,/\[credential\]/);assert.match(result.stderr,/cleanup: revoked/);
+  for(const value of [secret,account,device,'ambient-broad-token','ambient-alias-token'])assert.ok(!(result.stdout+result.stderr).includes(value));
+ }
+ const missing=await f.run(['/missing-command-for-business-run']);assert.equal(missing.code,127);assert.match(missing.stderr,/cleanup: revoked/);
+ assert.equal(f.state.issued,3);assert.equal(f.state.revocations,3);
+});
+
+test('business run refuses unavailable authority without spawning or retrying and reports unconfirmed cleanup separately from the child exit',async t=>{
+ const f=await fixture(t);f.state.refuse=true;
+ let result=await f.run([process.execPath,'-e','console.log("SHOULD-NOT-RUN")']);
+ assert.equal(result.code,1);assert.ok(!result.stdout.includes('SHOULD-NOT-RUN'));assert.ok(!result.stderr.includes(secret));assert.equal(f.state.issued,1);
+ f.state.refuse=false;f.state.cleanupFails=true;
+ result=await f.run([process.execPath,'-e','process.exit(23)']);assert.equal(result.code,23);assert.match(result.stderr,/cleanup: unconfirmed/);assert.match(result.stderr,/rer business cleanup [a-f0-9-]+/);
+ const lease=[...f.state.leases.keys()][0];f.state.cleanupFails=false;
+ const cleaned=await f.start(['cleanup',lease]).result;assert.equal(cleaned.code,0);assert.match(cleaned.stderr,/cleanup: revoked/);
+ assert.equal(f.state.issued,2,'cleanup never reissues a credential');
+});
+
+test('business run forwards signals and enforces credential expiry, then revokes before exiting with the child signal',async t=>{
+ const f=await fixture(t);
+ for(const signal of ['SIGINT','SIGTERM']){
+  const running=f.start(['run','--grant','grant-1','--',process.execPath,'-e','console.log("COMMAND_READY");setInterval(()=>{},1000)']);
+  await new Promise((resolve,reject)=>{const timeout=setTimeout(()=>reject(Error('child did not start')),15000);const see=()=>{if(running.output().includes('COMMAND_READY')){clearTimeout(timeout);running.child.stdout.off('data',see);resolve();}};running.child.stdout.on('data',see);see();});
+  running.child.kill(signal);const result=await running.result;
+  assert.equal(result.signal,signal);assert.match(result.stderr,/cleanup: revoked/);
+ }
+ f.state.expiryMs=1000;
+ const expired=await f.run([process.execPath,'-e','setInterval(()=>{},1000)']);assert.equal(expired.signal,'SIGTERM');assert.match(expired.stderr,/cleanup: revoked/);
+ assert.equal(f.state.revocations,3);
+});
+
+test('business run reaches the ordinary rer deploy dry-run child without live provider mutation',{timeout:300000},async t=>{
+ const f=await fixture(t);
+ const result=await f.run([process.execPath,entry,'deploy','--dry-run','--cwd',join(base,'default-seed'),'--json']);
+ assert.equal(result.code,0,result.stderr+'\n'+result.stdout);
+ const receipt=result.stdout.trim().split('\n').filter(Boolean).map(line=>{try{return JSON.parse(line);}catch{return null;}}).filter(Boolean).at(-1);
+ assert.equal(receipt.ok,true);assert.equal(receipt.dryRun,true);assert.equal(receipt.deployed,false);assert.equal(receipt.providerChecked,false);
+ assert.equal(f.state.issued,1);assert.equal(f.state.revocations,1);
+ assert.ok(!(result.stdout+result.stderr).includes(secret));assert.match(result.stderr,/cleanup: revoked/);
+});
diff --git a/cli/business/agent-args.mjs b/cli/business/agent-args.mjs
new file mode 100644
index 00000000..39a2db48
--- /dev/null
+++ b/cli/business/agent-args.mjs
@@ -0,0 +1,60 @@
+import { readFile } from 'node:fs/promises';
+import { aliases } from './agent-table.mjs';
+
+const booleans = new Set(['json', 'wait', 'publish', 'help']);
+const numbers = new Set(['timeout', 'interval']);
+export class Usage extends Error {}
+
+const snake = flag => (aliases[flag] ?? flag).replaceAll('-', '_');
+// A value that starts like JSON is sent as JSON; @FILE reads a JSON (or text) file. Anything else is text.
+async function value(flag, text) {
+ let source = text;
+ if (text.startsWith('@')) {
+  try { source = (await readFile(text.slice(1), 'utf8')).trim(); } catch { throw new Usage(`Could not read ${text.slice(1)} for --${flag}.`); }
+  if (!/^[[{]/.test(source)) return source;
+ }
+ if (!/^[[{]/.test(source)) return source;
+ try { return JSON.parse(source); } catch { throw new Usage(`--${flag} is not valid JSON.`); }
+}
+
+/** Flags and bare words to { arguments, control, positional }. Flags become arguments (kebab-case to snake_case); --json,
+ * --wait, --publish, --timeout SECONDS and --interval SECONDS steer rer itself; --args JSON adds a whole arguments object. */
+export async function parseArguments(args) {
+ const control = {}, named = {}, words = [];
+ for (let index = 0; index < args.length; index++) {
+  const token = args[index];
+  if (token === '-h') { control.help = true; continue; }
+  if (!token.startsWith('--') || token === '--') { words.push(token); continue; }
+  const [flag, inline] = token.slice(2).split(/=(.*)/s, 2);
+  if (!/^[a-z][a-z0-9-]{0,40}$/.test(flag)) throw new Usage(`Unknown flag ${token.slice(0, 40)}.`);
+  if (booleans.has(flag)) { control[flag] = true; continue; }
+  const text = inline ?? args[++index];
+  if (text === undefined || inline === undefined && text.startsWith('--')) throw new Usage(`A value is required for --${flag}.`);
+  const target = numbers.has(flag) ? control : named;
+  const key = numbers.has(flag) ? flag : snake(flag);
+  if (Object.hasOwn(target, key)) throw new Usage(`Repeated flag --${flag}.`);
+  if (numbers.has(flag)) {
+   const number = Number(text);
+   if (!Number.isFinite(number) || number <= 0 || number > 86400) throw new Usage(`--${flag} takes a number of seconds.`);
+   control[flag] = number;
+  } else named[key] = await value(flag, text);
+ }
+ const { args: whole, ...rest } = named;
+ if (whole !== undefined && (whole === null || typeof whole !== 'object' || Array.isArray(whole))) throw new Usage('--args takes a JSON object.');
+ for (const key of Object.keys(whole ?? {})) if (Object.hasOwn(rest, key)) throw new Usage(`${key} is given both as a flag and in --args.`);
+ return { arguments: { ...whole, ...rest }, control, words };
+}
+
+/** Put the bare words into the row's positional argument: free text for a sentence, exactly one word for an identifier. */
+export function place(row, parsed) {
+ const { words } = parsed, into = row.positional;
+ if (!words.length) return parsed.arguments;
+ if (!into) throw new Usage(`Unexpected word "${words[0].slice(0, 40)}". Pass values as --flag VALUE.`);
+ if (Object.hasOwn(parsed.arguments, into)) throw new Usage(`${into} is given both as a flag and as words.`);
+ if (into !== 'intent' && words.length > 1) throw new Usage(`Expected one ${into.replaceAll('_', '-')}, got ${words.length} words.`);
+ return { ...parsed.arguments, [into]: words.join(' ') };
+}
+
+export function missing(row, argumentsObject) {
+ return (row.required ?? []).filter(name => argumentsObject[name] === undefined);
+}
diff --git a/cli/business/agent-help.mjs b/cli/business/agent-help.mjs
new file mode 100644
index 00000000..7afd9647
--- /dev/null
+++ b/cli/business/agent-help.mjs
@@ -0,0 +1,53 @@
+import { rows, families } from './agent-table.mjs';
+
+const verb = name => name.split(' ')[1];
+const exits = `Exits 0 done, 1 refused or failed (the server's message is printed), 2 usage, 3 not built yet, 75 still working when\n--timeout ran out. A verb the owner has not granted this computer names where the owner grants it: Business, under Computers.`;
+const flags = `
+  --app ID, --installation-id ID   The installed app (from rer business installations list)
+  --FLAG VALUE                     Any other flag is an argument of the tool: --change-id, --preparation-id,
+                                   --domain-id, --request-key, --method, --surface, --hostname, --public-path
+                                   (kebab-case becomes snake_case). A value that starts with { or [ is JSON;
+                                   @FILE reads a file. --args JSON gives the whole arguments object
+  --json                           Print the tool's structuredContent as JSON (progress goes to stderr)
+  --wait, --timeout SECONDS, --interval SECONDS
+                                   Follow to the end where the verb supports it (default 1800 s, polling every 15 s)
+${exits}`;
+
+/** The lines the advanced-commands help adds for the agent verbs. */
+export const agentUsage = `
+Agent verbs (Usage: rer business FAMILY VERB [--flags] [--json])
+Act on the company's installed apps from this computer, with no browser. Needs rer business connect first.
+${Object.entries(rows).map(([name, row]) => `  ${name.padEnd(24)} ${row.about}`).join('\n')}
+  tools                    List the tools the Business server offers
+  call TOOL [--flags]      Call a tool that has no verb of its own yet
+  mcp                      A local stdio MCP server for Claude Code or Codex: add \`rer business mcp\` as a server
+                           and the agent never handles a token
+  change request --app ID "WHAT TO CHANGE" [--wait] [--publish]
+                           --wait follows the change to its preview; --publish also publishes it and waits for live
+${exits}
+`;
+
+const family = name => Object.entries(rows).filter(([key]) => key.split(' ')[0] === name)
+ .map(([key, row]) => `  ${verb(key).padEnd(22)} ${row.about}`).join('\n');
+const help = name => `Usage: rer business ${name} VERB [--flags] [--json]
+${family(name)}
+${flags}
+`;
+
+export const agentHelp = {
+ ...Object.fromEntries(families.map(name => [name, help(name)])),
+ tools: `Usage: rer business tools [--json]
+List the tools the Business server offers: name and a one-line description. Use rer business call TOOL to call one that has no verb.
+`,
+ call: `Usage: rer business call TOOL [--flag VALUE ...] [--args JSON] [--json]
+Call any Business tool by name, such as installation.status. Flags become the tool's arguments (kebab-case to snake_case).
+Exits 0 done, 1 refused or failed, 3 not built yet.
+`,
+ mcp: `Usage: rer business mcp
+Run a local MCP server on stdin and stdout (newline-delimited JSON-RPC, revision 2025-11-25) that forwards to the Business
+MCP. It keeps the short-lived bearer fresh from this computer's pairing, so the agent that starts it never handles a token.
+Claude Code: claude mcp add business -- rer business mcp
+Codex: add [mcp_servers.business] with command = "rer" and args = ["business", "mcp"]
+Needs rer business connect first. Only protocol messages go to stdout; diagnostics go to stderr.
+`,
+};
diff --git a/cli/business/agent-output.mjs b/cli/business/agent-output.mjs
new file mode 100644
index 00000000..a4a68414
--- /dev/null
+++ b/cli/business/agent-output.mjs
@@ -0,0 +1,38 @@
+import { redact } from './errors.mjs';
+
+const scalar = value => value === null || ['string', 'number', 'boolean'].includes(typeof value);
+export const clean = (value, limit = 300) => redact(typeof value === 'string' ? value : JSON.stringify(value)).replace(/\s+/g, ' ').trim().slice(0, limit);
+
+// One plain line for an object: its scalar fields as key=value, nested values as compact JSON.
+function item(object) {
+ if (scalar(object)) return clean(object);
+ return Object.entries(object).filter(([, value]) => value !== null && value !== undefined).map(([key, value]) => `${key}=${clean(value, 120)}`).join('  ');
+}
+
+/** A tool result as a few plain lines. */
+export function plain(tool, data) {
+ if (tool === 'installations.list' && Array.isArray(data.installations)) {
+  if (!data.installations.length) return ['No apps are installed for this company yet.'];
+  return data.installations.map(app => [app.installation_id, app.app, app.name, app.state, app.version, app.app_url].filter(part => part !== undefined && part !== null).map(part => clean(part, 120)).join('  '));
+ }
+ const lines = [];
+ for (const [key, value] of Object.entries(data)) {
+  if (value === null || value === undefined) continue;
+  if (Array.isArray(value)) { lines.push(`${key}: ${value.length ? '' : 'none'}`.trimEnd(), ...value.map(entry => `  - ${item(entry)}`)); }
+  else if (scalar(value)) lines.push(`${key}: ${clean(value)}`);
+  else lines.push(`${key}: ${item(value)}`);
+ }
+ return lines.length ? lines : ['Done.'];
+}
+
+/** Why a tool refused, in words the person reading an agent's transcript can act on. */
+export function refusalText(data, ownerPage) {
+ const message = typeof data?.message === 'string' && data.message ? clean(data.message, 500) : null;
+ if (data?.status === 'not_built') return `Not built yet: ${message ?? 'Business has not built this yet.'}`;
+ if (data?.status === 'action_not_granted') {
+  const action = typeof data.action === 'string' ? clean(data.action, 80) : 'this action';
+  return `The owner has not let this computer do "${action}". The owner grants it in Business, under Computers: ${ownerPage}`;
+ }
+ const code = typeof data?.code === 'string' ? ` (${clean(data.code, 80)})` : '';
+ return `Business refused: ${message ?? data?.status ?? 'no reason given'}${code}`;
+}
