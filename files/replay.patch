@@ -0,0 +1,50 @@
+import { createServer } from 'node:http';
+
+// A fake Business MCP at the network edge: the executors token route and /api/business/mcp (Streamable HTTP JSON-RPC 2025-11-25),
+// with the agent tools' result shapes. `state` is the test's handle on what it saw and how it answers next.
+export async function agentServer(t, device) {
+ const state = { mints: 0, bearers: new Set(), stale: new Set(), calls: [], followed: [], published: 0, stall: false };
+ // The phases the next change.follow calls return, the last one repeating; what each phase says to do next.
+ let script = [];
+ const next = { working: 'wait', preview_ready: 'publish', publishing: 'wait', live: 'done' };
+ const tools = [['installations.list', 'List the installed apps'], ['change.request', 'Ask for a change'], ['domain.records', 'DNS records'], ['app.send_sign_in_link', 'Sign-in link']];
+ const refusal = structuredContent => ({ isError: true, content: [{ type: 'text', text: structuredContent.message }], structuredContent });
+ const answer = (structuredContent) => ({ content: [{ type: 'text', text: 'ok' }], structuredContent });
+ function call(name, args) {
+  state.calls.push([name, args]);
+  if (name === 'installations.list') return answer({ installations: [{ installation_id: 'inst_1', app: 'happytohelp', name: 'Support', state: 'running', version: '0.4.1', app_url: 'https://help.example.test' }] });
+  if (name === 'change.request') { script = ['working', 'working', 'preview_ready']; return answer({ change: { id: 'chg_1', state: 'working' }, next: 'wait' }); }
+  if (name === 'change.follow') {
+   const phase = state.stall ? 'working' : script.length > 1 ? script.shift() : script[0];
+   state.followed.push(phase);
+   return answer({ change: { id: args.change_id, state: phase }, next: next[phase] });
+  }
+  if (name === 'change.publish') { script = ['publishing', 'live']; state.published++; return answer({ change: { id: args.change_id, state: 'publishing' }, next: 'wait' }); }
+  if (name === 'domain.records') return refusal({ status: 'not_built', code: 'not_built', message: 'not built yet' });
+  if (name === 'app.send_sign_in_link') return refusal({ status: 'action_not_granted', code: 'action_not_granted', action: 'app.send_sign_in_link', message: 'The owner has not granted this action.' });
+  return refusal({ status: 'refused', code: 'unknown_tool', message: `No tool ${name}` });
+ }
+ const server = createServer(async (request, response) => {
+  let text = ''; for await (const chunk of request) text += chunk;
+  const body = text ? JSON.parse(text) : {};
+  const json = (status, value) => { response.writeHead(status, { 'content-type': 'application/json' }); response.end(JSON.stringify(value)); };
+  const token = (request.headers.authorization ?? '').replace(/^Bearer /, '');
+  if (request.url === '/api/business/executors/token') {
+   if (token !== device) return json(401, { error: 'unknown device' });
+   const bearer = `bz_task_fixture-${++state.mints}`; state.bearers.add(bearer);
+   return json(200, { access_token: bearer, token_type: 'Bearer', expires_in: 300, expires_at: new Date(Date.now() + 300_000).toISOString(), audience: `${state.origin}/api/business/mcp`, task_id: null });
+  }
+  if (request.url !== '/api/business/mcp') return json(404, { error: 'no route' });
+  if (!state.bearers.has(token) || state.stale.has(token)) return json(401, { error: 'bearer expired' });
+  const reply = result => json(200, { jsonrpc: '2.0', id: body.id, result });
+  if (body.method === 'initialize') return reply({ protocolVersion: '2025-11-25', capabilities: { tools: {} }, serverInfo: { name: 'business', version: '1' } });
+  if (body.method === 'notifications/initialized') { response.writeHead(202, { 'content-length': 0 }); return response.end(); }
+  if (body.method === 'tools/list') return reply({ tools: tools.map(([name, description]) => ({ name, description, inputSchema: { type: 'object' } })) });
+  if (body.method === 'tools/call') return reply(call(body.params.name, body.params.arguments));
+  return json(200, { jsonrpc: '2.0', id: body.id, error: { code: -32601, message: 'Method not found' } });
+ });
+ await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+ t.after(() => server.close());
+ state.origin = `http://127.0.0.1:${server.address().port}`;
+ return state;
+}
diff --git a/default-seed/scripts/base-cli/cli/README.md b/default-seed/scripts/base-cli/cli/README.md
index 3c68cc6a..abe0d9d1 100644
--- a/default-seed/scripts/base-cli/cli/README.md
+++ b/default-seed/scripts/base-cli/cli/README.md
@@ -697,3 +697,43 @@ unattempted sizes `complete:false`; these files keep the existing statement name
 SQL and bound parameters and carry diagnostic flow summaries. Missing work never
 produces a passing growth verdict. See the size section of
 [the command contract](../export/SEED-COMMAND-CONTRACT.md#statement-size-and-growth-sc-15).
+
+## Run a command with a Business grant
+
+Pair with the Business using `rer business connect --business ID`. The owner
+approves this agent, ticks **Run software commands with an approved cloud grant**,
+Connects Cloudflare, selects the exact Business account and approves a per-agent
+grant with explicit resource permissions and expiry. These choices install nothing.
+
+```sh
+rer business run --grant GRANT_ID -- rer deploy
+rer business run --grant GRANT_ID -- any-command 'argument with spaces'
+```
+
+`cloudflare.token` in the Business MCP describes the exchange without returning a
+credential. Only the paired rer exchange receives a child token; the parent OAuth
+credential stays on the trusted server. The command gets `CLOUDFLARE_API_TOKEN`
+and `CLOUDFLARE_ACCOUNT_ID` in its environment. Cloudflare credential aliases from
+the caller environment are removed. No shell is inserted and arguments after
+`--`, including help flags, are passed unchanged. Existing `run [--once]` continues
+its computer check-in behavior.
+
+This is an environment boundary, not a sandbox. The selected process and its
+descendants can read and use the credential, and a malicious process can disclose
+it or read other files or OS credentials available to the same user. Use software
+you trust. Output masks the credential and common encoded forms across chunk
+boundaries; it cannot hide every transformation a malicious process invents.
+Commands may load their own files and credentials. The wrapper supplies only the
+approved credential, never retries with broader or ambient access, and does not
+protect a process from its own deliberate credential loading.
+
+The child expires after at most 15 minutes, bounded also by the grant and the
+provider authorization. The wrapper interrupts a command at that expiry. It
+requests revocation after success, failure, signals or spawn failure; SIGKILL,
+crashes, network loss and lost acknowledgements may leave a token until server
+expiry. Child exit codes and Unix terminating signals are preserved. Cleanup has
+its own stderr status, including **unconfirmed**, which is never called revoked.
+The safe lease ID in that status supports `rer business cleanup LEASE` to retry
+revocation and `rer business cleanup LEASE --status` to read its status. Cleanup
+needs the original pairing, but does not require the removed deploy action or an
+active grant. No child token is saved in state, OS storage, logs or MCP output.
diff --git a/default-seed/scripts/base-cli/cli/business/agent-args.mjs b/default-seed/scripts/base-cli/cli/business/agent-args.mjs
new file mode 100644
index 00000000..39a2db48
--- /dev/null
+++ b/default-seed/scripts/base-cli/cli/business/agent-args.mjs
@@ -0,0 +1,60 @@
+import { readFile } from 'node:fs/promises';
+import { aliases } from './agent-table.mjs';
+
+const booleans = new Set(['json', 'wait', 'publish', 'help']);
+const numbers = new Set(['timeout', 'interval']);
+export class Usage extends Error {}
+
+const snake = flag => (aliases[flag] ?? flag).replaceAll('-', '_');
+// A value that starts like JSON is sent as JSON; @FILE reads a JSON (or text) file. Anything else is text.
+async function value(flag, text) {
+ let source = text;
+ if (text.startsWith('@')) {
+  try { source = (await readFile(text.slice(1), 'utf8')).trim(); } catch { throw new Usage(`Could not read ${text.slice(1)} for --${flag}.`); }
+  if (!/^[[{]/.test(source)) return source;
+ }
+ if (!/^[[{]/.test(source)) return source;
+ try { return JSON.parse(source); } catch { throw new Usage(`--${flag} is not valid JSON.`); }
+}
+
+/** Flags and bare words to { arguments, control, positional }. Flags become arguments (kebab-case to snake_case); --json,
+ * --wait, --publish, --timeout SECONDS and --interval SECONDS steer rer itself; --args JSON adds a whole arguments object. */
+export async function parseArguments(args) {
+ const control = {}, named = {}, words = [];
+ for (let index = 0; index < args.length; index++) {
+  const token = args[index];
+  if (token === '-h') { control.help = true; continue; }
+  if (!token.startsWith('--') || token === '--') { words.push(token); continue; }
+  const [flag, inline] = token.slice(2).split(/=(.*)/s, 2);
+  if (!/^[a-z][a-z0-9-]{0,40}$/.test(flag)) throw new Usage(`Unknown flag ${token.slice(0, 40)}.`);
+  if (booleans.has(flag)) { control[flag] = true; continue; }
+  const text = inline ?? args[++index];
+  if (text === undefined || inline === undefined && text.startsWith('--')) throw new Usage(`A value is required for --${flag}.`);
+  const target = numbers.has(flag) ? control : named;
+  const key = numbers.has(flag) ? flag : snake(flag);
+  if (Object.hasOwn(target, key)) throw new Usage(`Repeated flag --${flag}.`);
+  if (numbers.has(flag)) {
+   const number = Number(text);
+   if (!Number.isFinite(number) || number <= 0 || number > 86400) throw new Usage(`--${flag} takes a number of seconds.`);
+   control[flag] = number;
+  } else named[key] = await value(flag, text);
+ }
+ const { args: whole, ...rest } = named;
+ if (whole !== undefined && (whole === null || typeof whole !== 'object' || Array.isArray(whole))) throw new Usage('--args takes a JSON object.');
+ for (const key of Object.keys(whole ?? {})) if (Object.hasOwn(rest, key)) throw new Usage(`${key} is given both as a flag and in --args.`);
+ return { arguments: { ...whole, ...rest }, control, words };
+}
+
+/** Put the bare words into the row's positional argument: free text for a sentence, exactly one word for an identifier. */
+export function place(row, parsed) {
+ const { words } = parsed, into = row.positional;
+ if (!words.length) return parsed.arguments;
+ if (!into) throw new Usage(`Unexpected word "${words[0].slice(0, 40)}". Pass values as --flag VALUE.`);
+ if (Object.hasOwn(parsed.arguments, into)) throw new Usage(`${into} is given both as a flag and as words.`);
+ if (into !== 'intent' && words.length > 1) throw new Usage(`Expected one ${into.replaceAll('_', '-')}, got ${words.length} words.`);
+ return { ...parsed.arguments, [into]: words.join(' ') };
+}
+
+export function missing(row, argumentsObject) {
+ return (row.required ?? []).filter(name => argumentsObject[name] === undefined);
+}
diff --git a/default-seed/scripts/base-cli/cli/business/agent-help.mjs b/default-seed/scripts/base-cli/cli/business/agent-help.mjs
