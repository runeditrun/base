index 0000000..7dcf225
--- /dev/null
+++ b/scripts/publish-check/progress.mjs
@@ -0,0 +1,40 @@
+// A worker observation is never a report or evidence of scan completion.
+import { createHash } from 'node:crypto';
+import { fstatSync, readSync } from 'node:fs';
+
+export const progressBytes = 1024;
+const phases = new Set(['preparation', 'fetch', 'hydration', 'history-text', 'gitleaks', 'references']);
+const operations = new Set(['none', 'git.rev-parse', 'git.fetch', 'git.rev-list', 'git.log', 'git.config',
+  'git.ls-tree', 'git.for-each-ref', 'git.cat-file', 'git.other',
+  'gitleaks.version', 'gitleaks.git', 'gitleaks.dir', 'gitleaks.stdin', 'gh.graphql', 'gh.rest']);
+const keys = (value, expected) => value && typeof value === 'object' && !Array.isArray(value) &&
+  Object.keys(value).length === expected.length && expected.every(key => Object.hasOwn(value, key));
+const number = value => Number.isSafeInteger(value) && value >= 0;
+const count = value => value === null || number(value);
+
+export function readProgress(fd) {
+  try {
+    if (fd === undefined || fstatSync(fd).size !== progressBytes) return null;
+    const frame = Buffer.alloc(progressBytes);
+    if (readSync(fd, frame, 0, frame.length, 0) !== frame.length || frame[64] !== 10) return null;
+    const body = frame.subarray(65);
+    if (createHash('sha256').update(body).digest('hex') !== frame.subarray(0, 64).toString('ascii')) return null;
+    const value = JSON.parse(body.toString('utf8'));
+    if (!keys(value, ['lastEnteredPhase', 'lastCompletedPhase', 'observedElapsedMs', 'activeOperation',
+      'selectedRevisions', 'publicRevisions', 'historyCommits', 'publicCommits', 'hydration']) ||
+      ![value.lastEnteredPhase, value.lastCompletedPhase].every(phase => phase === null || phases.has(phase)) ||
+      !operations.has(value.activeOperation) || !number(value.observedElapsedMs) ||
+      ![value.selectedRevisions, value.publicRevisions, value.historyCommits, value.publicCommits].every(count) ||
+      !keys(value.hydration, ['missingBefore', 'missingAfter', 'fetches']) ||
+      !Object.values(value.hydration).every(count)) return null;
+    // Construct the public shape explicitly. Never merge worker objects.
+    return {
+      lastEnteredPhase: value.lastEnteredPhase, lastCompletedPhase: value.lastCompletedPhase,
+      observedElapsedMs: value.observedElapsedMs, activeOperation: value.activeOperation,
+      selectedRevisions: value.selectedRevisions, publicRevisions: value.publicRevisions,
+      historyCommits: value.historyCommits, publicCommits: value.publicCommits,
+      hydration: { missingBefore: value.hydration.missingBefore, missingAfter: value.hydration.missingAfter,
+        fetches: value.hydration.fetches },
+    };
+  } catch { return null; }
+}
diff --git a/scripts/publish-check/progress.py b/scripts/publish-check/progress.py
new file mode 100644
index 0000000..ccb9471
--- /dev/null
+++ b/scripts/publish-check/progress.py
@@ -0,0 +1,81 @@
+"""Latest value-free worker observation in one private, fixed-size frame."""
+from contextlib import contextmanager
+import hashlib
+import json
+import os
+import stat
+from time import monotonic
+
+FRAME_BYTES = 1024
+MAX_NUMBER = 2**53 - 1
+_current = None
+
+
+class Progress:
+    def __init__(self):
+        self.started = monotonic()
+        self.value = dict(lastEnteredPhase=None, lastCompletedPhase=None, observedElapsedMs=0,
+                          activeOperation='none', selectedRevisions=None, publicRevisions=None,
+                          historyCommits=None, publicCommits=None,
+                          hydration=dict(missingBefore=None, missingAfter=None, fetches=None))
+
+    def publish(self):
+        self.value['observedElapsedMs'] = min(MAX_NUMBER, int((monotonic() - self.started) * 1000))
+        body = json.dumps(self.value, separators=(',', ':'), allow_nan=False).encode()
+        if len(body) > FRAME_BYTES - 65:
+            return
+        body = body.ljust(FRAME_BYTES - 65)
+        frame = hashlib.sha256(body).hexdigest().encode() + b'\n' + body
+        try:
+            # fd 4 is opened by Node, passed only to this worker, and never
+            # inherited by native commands. No source-controlled path is read.
+            os.pwrite(4, frame, 0)
+        except OSError:
+            pass  # Observations cannot change scan success or refusal.
+
+
+def start():
+    global _current
+    try:
+        descriptor = os.fstat(4)
+        if not stat.S_ISREG(descriptor.st_mode) or descriptor.st_size != FRAME_BYTES:
+            return
+    except OSError:
+        return
+    _current = Progress()
+    enter('preparation')
+
+
+def enter(phase):
+    if _current:
+        _current.value['lastEnteredPhase'] = phase
+        _current.publish()
+
+
+def completed(phase):
+    if _current:
+        _current.value['lastCompletedPhase'] = phase
+        _current.publish()
+
+
+def counts(*, hydration=False, **values):
+    if _current:
+        target = _current.value['hydration'] if hydration else _current.value
+        target.update({key: value if type(value) is int and 0 <= value <= MAX_NUMBER else None
+                       for key, value in values.items()})
+        _current.publish()
+
+
+@contextmanager
+def operation(name):
+    if not _current:
+        yield
+        return
+    previous = _current.value['activeOperation']
+    _current.value['activeOperation'] = name
+    _current.publish()
+    try:
+        yield
+    finally:
+        _current.value['activeOperation'] = previous
+        _current.publish()
