    {"id": "deliver", "tool": "fixture.records.deliver", "args": {"id": {"$from": "create", "pointer": "/id"}}, "expect": [{"class": "external", "facts": {"measure": 1, "counterparty": "known"}}]},
    {"id": "deny-undeclared", "tool": "fixture.records.denied", "args": {"id": {"$from": "create", "pointer": "/id"}}, "expect": [{"class": "external", "facts": {"measure": 1, "counterparty": "new"}}]},
    {"id": "list", "tool": "fixture.records.list", "args": {}, "expect": [{"class": "standard", "facts": {"measure": 1}}]},
    {"id": "events", "tool": "fixture.events.list", "args": {"limit": 200}, "expect": [{"class": "standard", "facts": {"measure": 1}}]},
