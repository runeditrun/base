    {"id": "grants", "tool": "fixture.access.grants", "args": {"id": {"$from": "create", "pointer": "/id"}}, "expect": [{"facts": {"measure": 1}, "class": "standard"}]},
    {"id": "revoke", "tool": "fixture.access.revoke", "args": {"id": {"$from": "create", "pointer": "/id"}}, "expect": [{"facts": {"measure": 1, "direction": "narrows"}, "class": "access"}]},
    {"id": "protected", "tool": "fixture.records.protected", "args": {"id": {"$from": "create", "pointer": "/id"}}, "expect": [{"facts": {"measure": 1, "kind": "personal"}, "class": "sensitive"}]}
  ],
  "verification": {"network": {"module": "provider.mjs", "origins": ["https://api.openai.com", "https://receiver.example.invalid"]}},
  "narrowings": [
