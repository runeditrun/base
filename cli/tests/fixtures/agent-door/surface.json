    {"name": "fixture.access.grants", "scope": "records:read", "readOnly": true, "classes": ["standard"], "clauses": ["BASE-AGENT-005"]},
    {"name": "fixture.records.protected", "scope": "records:write", "readOnly": false, "classes": ["sensitive"], "clauses": ["BASE-AGENT-004"], "proof": "native", "proofKind": "step_up"}
