{
  "schema": "rer-agent-surface/1",
  "seed": "fixture",
  "specialist": "operations",
  "tools": [
    { "name": "fixture.records.list", "scope": "records:read", "readOnly": true, "classes": ["standard"], "clauses": ["BASE-AGENT-002"] },
    { "name": "fixture.records.create", "scope": "records:write", "readOnly": false, "classes": ["standard"], "clauses": ["BASE-AGENT-002"] },
    { "name": "fixture.records.send", "scope": "records:write", "readOnly": false, "classes": ["external"], "clauses": ["BASE-AGENT-006"] },
    { "name": "fixture.records.deliver", "scope": "records:write", "readOnly": false, "classes": ["external"], "clauses": ["BASE-AGENT-006"] },
    { "name": "fixture.records.denied", "scope": "records:write", "readOnly": false, "classes": ["external"], "clauses": ["BASE-AGENT-006"] },
    { "name": "fixture.records.schedule", "scope": "records:write", "readOnly": false, "classes": ["standard"], "clauses": ["BASE-AGENT-004"] },
    { "name": "fixture.events.list", "scope": "events:read", "readOnly": true, "classes": ["standard"], "clauses": ["BASE-AGENT-010"] }
  ],
  "notTools": [],
  "resources": [],
  "escalations": [],
  "durable": [
    { "id": "scheduled-create", "tool": "fixture.records.schedule", "args": { "value": "Scheduled operations note" }, "expect": [{ "class": "standard", "facts": { "measure": 1 } }], "runs": "fixture.records.create" }
  ],
  "witness": { "tool": "fixture.records.list", "args": {} },
  "journey": [
    { "id": "create", "tool": "fixture.records.create", "args": { "value": "Quarterly operations note" }, "expect": [{ "class": "standard", "facts": { "measure": 1 } }], "inject": { "classes": ["external"], "counterparty": "public", "policy": "blocked" } },
    { "id": "send-json", "tool": "fixture.records.send", "args": { "id": { "$from": "create", "pointer": "/id" }, "stream": false }, "expect": [{ "class": "external", "facts": { "measure": 1, "counterparty": "known" } }], "inject": { "classes": ["standard"], "counterparty": "internal" } },
    { "id": "send-stream", "tool": "fixture.records.send", "args": { "id": { "$from": "create", "pointer": "/id" }, "stream": true }, "expect": [{ "class": "external", "facts": { "measure": 1, "counterparty": "known" } }] },
    { "id": "deliver", "tool": "fixture.records.deliver", "args": { "id": { "$from": "create", "pointer": "/id" } }, "expect": [{ "class": "external", "facts": { "measure": 1, "counterparty": "known" } }] },
    { "id": "deny-undeclared", "tool": "fixture.records.denied", "args": { "id": { "$from": "create", "pointer": "/id" } }, "expect": [{ "class": "external", "facts": { "measure": 1, "counterparty": "new" } }] },
    { "id": "list", "tool": "fixture.records.list", "args": {}, "expect": [{ "class": "standard", "facts": { "measure": 1 } }] },
    { "id": "events", "tool": "fixture.events.list", "args": { "limit": 200 }, "expect": [{ "class": "standard", "facts": { "measure": 1 } }] }
  ],
  "verification": {
    "network": { "module": "provider.mjs", "origins": ["https://api.openai.com", "https://receiver.example.invalid"] }
  }
}
