{
  "name": "@run-edit-run/default-seed-reference",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "build": "node scripts/rer.mjs build",
    "local:setup": "node scripts/rer.mjs setup",
    "local:dev": "node scripts/rer.mjs dev",
    "dev": "node scripts/rer.mjs dev",
    "preview": "node scripts/rer.mjs preview",
    "typecheck": "tsc --build --incremental",
    "test:typecheck": "node scripts/base-onboarding/queued-entry.mjs test:typecheck -- sh -c \"node --test tests/typecheck/*.test.mjs\"",
    "test:runtime": "node scripts/base-onboarding/queued-entry.mjs test:runtime -- sh -c \"pnpm build && node tests/e2e/reference-runtime.mjs\"",
    "verify": "node scripts/rer.mjs verify",
    "test:local-setup": "node scripts/base-onboarding/queued-entry.mjs test:local-setup -- sh -c \"node --test --test-concurrency=1 tests/local-setup/*.test.mjs\"",
    "test:local-journey": "node scripts/base-onboarding/queued-entry.mjs test:local-journey -- sh -c \"node --test --test-concurrency=1 tests/local-journey/*.test.mjs\"",
    "test:operator-auth": "node scripts/base-onboarding/queued-entry.mjs test:operator-auth -- sh -c \"pnpm build && node --test tests/operator-auth/*.test.mjs\"",
    "test:private-response": "node scripts/base-onboarding/queued-entry.mjs test:private-response -- sh -c \"pnpm build && node --test tests/e2e/private-response.test.mjs tests/e2e/start-response-stream.test.mjs\"",
    "test:built": "node scripts/base-onboarding/queued-entry.mjs test:built -- sh -c \"node --test tests/operator-auth/*.test.mjs && node --test tests/e2e/private-response.test.mjs tests/e2e/start-response-stream.test.mjs && node tests/e2e/reference-runtime.mjs\"",
    "verify:app": "node scripts/base-onboarding/queued-entry.mjs verify:app -- sh -c \"pnpm typecheck && pnpm test:typecheck && pnpm build && pnpm test:built && pnpm test:local-setup && pnpm test:local-journey\"",
    "build:app": "node scripts/base-onboarding/queued-entry.mjs build:app -- sh -c \"vite build\"",
    "setup": "node scripts/rer.mjs setup",
    "reset": "node scripts/rer.mjs reset",
    "deploy": "node scripts/rer.mjs deploy",
    "export": "node scripts/rer.mjs export",
    "import": "node scripts/rer.mjs import",
    "release": "node scripts/rer.mjs release",
    "outbox": "node scripts/rer.mjs outbox",
    "doctor": "node scripts/rer.mjs doctor",
    "describe": "node scripts/rer.mjs describe",
    "check": "node scripts/rer.mjs check",
    "deps": "node scripts/rer.mjs install",
    "rer": "node scripts/rer.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.33",
    "@tanstack/react-start": "1.168.50",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "sharp": "0.35.5",
      "undici": "7.29.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
