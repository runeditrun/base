{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "default-seed-reference",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "default-seed-reference",
      "database_id": "local-reference-only",
      "migrations_dir": "migrations/core"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "default-seed-reference-files"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "default-seed-reference-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "default-seed-reference-jobs",
        "max_batch_size": 10,
        "max_retries": 3
      }
    ]
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
