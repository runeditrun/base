{
  "compilerOptions": {
    "incremental": false,
    "typeRoots": [
      "../../../default-seed/node_modules/@types",
      "../../../default-seed/node_modules/@cloudflare"
    ],
    "types": [
      "node",
      "workers-types"
    ],
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "../*.ts",
    "../conformance/*.d.mts",
    "*.ts",
    "*.mts"
  ],
  "exclude": []
}
