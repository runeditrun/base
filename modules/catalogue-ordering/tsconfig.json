{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"],
    "module": "NodeNext", "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true, "noEmit": true,
    "strict": true, "skipLibCheck": true, "erasableSyntaxOnly": true,
    "noUnusedLocals": true, "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true, "types": [], "allowJs": true
  },
  "include": ["*.ts", "conformance/*.mts", "tests/worker.ts" ]
}
